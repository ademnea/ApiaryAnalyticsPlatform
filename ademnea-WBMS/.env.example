# Copy to .env and fill in. Never commit .env.
# Production: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning.

APP_NAME="Apiary Analytics Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Where a "day" starts for daily figures (times are stored in UTC)
APP_LOCAL_TIMEZONE=Africa/Kampala

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 is what production runs. SQLite works for quick local setups:
#   DB_CONNECTION=sqlite  (and create database/database.sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ademnea
DB_USERNAME=ademnea
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis is only used for the IoT ingest queue. predis needs no PHP extension;
# use phpredis if the php-redis extension is installed.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- IoT ingestion ---------------------------------------------------------
# redis = devices -> apigateway.py -> Redis -> `php artisan iot:work`
# sqs   = devices -> AWS API Gateway -> SQS -> `php artisan iot:work`
IOT_QUEUE_DRIVER=redis
# Must match ADEMNEA_IOT_QUEUE_NAME given to apigateway.py
IOT_QUEUE_NAME=ademnea-iot-ingest
IOT_MAX_DELIVERY_ATTEMPTS=5
# Redis connection for the IoT list (default: iotredis, which has no key prefix)
# IOT_REDIS_CONNECTION=iotredis
IOT_SQS_QUEUE_URL=
# s3 = presigned S3 uploads for device media; local = local mock receiver
IOT_MEDIA_DISK=local

# --- Files -----------------------------------------------------------------
# Disk for public feedback attachments (defaults to FILESYSTEM_DISK)
# FEEDBACK_FILES_DISK=public

# --- AWS (S3 media, SQS) ---------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Keep true. false disables TLS certificate checks (only for a broken local CA bundle).
AWS_VERIFY_SSL=true

# --- Mail ------------------------------------------------------------------
# "log" writes emails to storage/logs/laravel.log; use smtp in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@ademnea.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Farmer notifications --------------------------------------------------
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Base URL for links in farmer emails (defaults to APP_URL)
MOBILE_APP_URL=https://app.ademnea.com

VITE_APP_NAME="${APP_NAME}"
